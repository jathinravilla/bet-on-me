# Copy to .env.local (never commit .env.local). `npm run keys` fills the generated ones for you.
MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://<vercel-domain>/api/strava/callback
BLOB_READ_WRITE_TOKEN=
SOLANA_RPC_URL=https://api.devnet.solana.com
TREASURY_SECRET_KEY=
WALLET_ENCRYPTION_KEY=
CRON_SECRET=
DEMO_MODE=true
# Local testing only: fake the blockchain (no real devnet transactions).
SOLANA_MOCK=false
