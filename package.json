{
  "name": "bet-on-me",
  "version": "1.0.0",
  "private": true,
  "description": "Bet On Me \u2014 backend (Vercel serverless) for sunhacks 2026",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local server/dev.ts",
    "test": "tsx --test server/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "keys": "tsx scripts/gen-keys.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "treasury": "tsx --env-file-if-exists=.env.local scripts/treasury-balance.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@solana/web3.js": "^1.99.0",
    "@vercel/blob": "^2.9.0",
    "bs58": "^5.0.0",
    "mongodb": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vercel/node": "^31.0.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^9.0.1"
    }
  }
}