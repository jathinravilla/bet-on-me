{
  "expo": {
    "name": "Bet On Me",
    "slug": "bet-on-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "betonme",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Bet On Me records a short video as proof that you did your dare.",
        "NSMicrophoneUsageDescription": "Bet On Me records audio so you can say the liveness word in your proof video."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1B3F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1B3F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Bet On Me records a short video as proof that you did your dare.",
          "microphonePermission": "Bet On Me records audio so you can say the liveness word in your proof video.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "backgroundColor": "#0A1B3F",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "76f93af2-6cf4-4366-b31b-587bb7acc32d"
      }
    },
    "owner": "jathinravilla",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/76f93af2-6cf4-4366-b31b-587bb7acc32d"
    }
  }
}
